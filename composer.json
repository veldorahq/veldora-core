{
    "name": "veldora/framework",
    "version": "0.5.2",
    "description": "The Veldora PHP Framework Core — Expressive routing, native templates, ORM, CLI, Auth, and more.",
    "type": "library",
    "keywords": ["veldora", "framework", "php", "mvc", "orm", "auth", "cli"],
    "license": "MIT",
    "authors": [
        {
            "name": "Shahriyar Fahim"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "psr/container": "^2.0"
    },
    "suggest": {
        "symfony/console": "Required only if using the full Symfony Console integration (^6.0|^7.0). A built-in polyfill is included for zero-dependency environments."
    },
    "bin": [
        "bin/veldora"
    ],
    "autoload": {
        "files": [
            "src/helpers.php",
            "src/Console/Polyfill.php"
        ],
        "psr-4": {
            "Veldora\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veldora\\Framework\\Tests\\": "tests/"
        }
    }
}
