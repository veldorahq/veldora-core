{
    "name": "veldora/framework",
    "description": "The Veldora Framework Core",
    "license": "MIT",
    "authors": [
        {
            "name": "Shahriyar Fahim"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2 || ^8.3",
        "psr/container": "^2.0",
        "symfony/console": "^6.0 || ^7.0"
    },
    "bin": [
        "bin/veldora"
    ],
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Veldora\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veldora\\Framework\\Tests\\": "tests/"
        }
    }
}
